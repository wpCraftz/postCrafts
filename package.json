{
	"name": "post-crafts",
	"version": "1.1.0",
	"description": "PostCrafts - Advanced Post Layout Blocks",
	"main": "build/index.js",
	"packageManager": "pnpm@12.4.1",
	"files": [
		"inc",
		"languages",
		"build",
		"readme.txt",
		"post-crafts.php"
	],
	"scripts": {
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:php": "vendor/bin/phpcs",
		"lint:php:fix": "vendor/bin/phpcbf",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-e2e",
		"test:unit": "wp-scripts test-unit-js",
		"test:php": "composer test",
		"test": "pnpm test:unit && composer test",
		"make-pot": "wp i18n make-pot . languages/postcrafts.pot --slug=postcrafts --domain=postcrafts --exclude=node_modules,src",
		"make-json": "wp i18n make-json languages/ --no-purge"
	},
	"author": "wpCraftz",
	"license": "GPL-2.0-or-later",
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/date": "^5.57.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/html-entities": "^4.57.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/scripts": "^27.9.0",
		"@wordpress/url": "^4.57.0",
		"fast-glob": "^3.3.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "~5.9.3"
	},
	"dependencies": {
		"array-move": "^4.0.0",
		"classnames": "^2.5.1",
		"lodash.debounce": "^4.0.8",
		"lodash.times": "^4.3.2",
		"react-sortable-hoc": "^2.0.0"
	}
}
