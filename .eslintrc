{
  "root": true,
 "extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
  "env": {
    "browser": true
  },
  "rules": {
    "jsdoc/check-indentation": "error",
    "@wordpress/dependency-group": "error"
  },
  "overrides": [{
    "files": [
      "**/__tests__/**/*.js",
      "**/test/*.js",
      "**/?(*.)test.js",
      "tests/js/**/*.js"
    ],
    "extends": [
      "plugin:@wordpress/eslint-plugin/test-unit"
    ],
    "rules": {
      // Helpers in tests/js that wrap expect() calls.
      "jest/expect-expect": [ "error", { "assertFunctionNames": [ "expect", "expectDisabled", "go" ] } ]
    }
  }]
}
